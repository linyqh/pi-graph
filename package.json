{
  "name": "@viccydev/pi-graph",
  "version": "1.7.0-rc.2",
  "description": "Graph workflow engine extension, skills, and prompts for the pi coding agent",
  "type": "module",
  "main": "./dist/extensions/graph-engine/embed.js",
  "types": "./dist/extensions/graph-engine/embed.d.ts",
  "exports": {
    ".": {
      "types": "./dist/extensions/graph-engine/embed.d.ts",
      "default": "./dist/extensions/graph-engine/embed.js"
    },
    "./extensions/*": "./extensions/*",
    "./graphs/*": "./graphs/*",
    "./skills/*": "./skills/*",
    "./prompts/*": "./prompts/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linyqh/pi-graph.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "README.md",
    "extensions",
    "graphs",
    "prompts",
    "skills",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/graph-engine/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.85.0 <2",
    "@earendil-works/pi-coding-agent": ">=0.85.0 <2",
    "@earendil-works/pi-tui": ">=0.85.0 <2",
    "typebox": "^1.3.7"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2",
    "@earendil-works/pi-ai": "0.85.0",
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-tui": "0.85.0",
    "@earendil-works/pi-server": "0.85.0"
  }
}
