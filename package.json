{
  "name": "@viccydev/pi-graph",
  "version": "1.2.3",
  "description": "Graph workflow engine extension, skills, and prompts for the pi coding agent",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linyqh/pi-graph.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22.19"
  },
  "files": [
    "README.md",
    "extensions",
    "graphs",
    "prompts",
    "skills"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./extensions/graph-engine/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.84.1",
    "@earendil-works/pi-coding-agent": "^0.84.1",
    "@earendil-works/pi-tui": "^0.84.1",
    "typebox": "^1.3.7"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  }
}
